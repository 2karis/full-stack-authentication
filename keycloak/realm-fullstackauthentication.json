{
  "realm": "fullstackauthentication",
  "displayName": "Full Stack Authentication",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "clientScopes": [
    {
      "name": "account",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "account audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "account",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Basic user, can read content"
      },
      {
        "name": "admin",
        "description": "Administrator, can create, update and delete content"
      }
    ]
  },
  "clients": [
    {
      "clientId": "api",
      "name": "api",
      "description": "Spring Boot API - resource server",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "frontend",
      "name": "frontend",
      "description": "Public client for browser/mobile clients (Expo, web)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8081/*",
        "http://localhost:8001/*",
        "http://localhost:4200/*",
        "http://localhost:19006/*",
        "exp://localhost:19000",
        "mobile://password-updated"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "account"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "api-admin",
      "name": "api-admin",
      "description": "Spring Boot API - service account for Keycloak's Admin REST API (password proxy)",
      "enabled": true,
      "secret": "af432e297be7755d2d7882db45ceb79cb6ef4b146fbc3151",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ],
      "clientRoles": {
        "account": [
          "manage-account",
          "view-applications",
          "manage-account-links",
          "delete-account",
          "view-groups",
          "manage-consent",
          "view-consent",
          "view-profile"
        ]
      }
    },
    {
      "username": "user",
      "email": "user@example.com",
      "firstName": "Normal",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "account": [
          "manage-account",
          "view-applications",
          "manage-account-links",
          "delete-account",
          "view-groups",
          "manage-consent",
          "view-consent",
          "view-profile"
        ]
      }
    },
    {
      "username": "service-account-api-admin",
      "enabled": true,
      "emailVerified": true,
      "serviceAccountClientId": "api-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}